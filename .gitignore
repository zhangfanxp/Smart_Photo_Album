
# ============================================
# Smart Photo Album - .gitignore
# Python + uv + MLX + Qwen3-VL + EmbeddingGemma 2
# ============================================

# --------------------------------------------
# 1. Python 虚拟环境
# --------------------------------------------
.venv/
venv/
env/
ENV/
.python_env/

# --------------------------------------------
# 2. Python 缓存和编译文件
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# --------------------------------------------
# 3. Python 打包与构建
# --------------------------------------------
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# --------------------------------------------
# 4. uv 和包管理器缓存
# --------------------------------------------
.uv/
.uv-cache/
.pip-cache/
pip-wheel-metadata/

# 保留 uv.lock 以便复现环境
# 不要忽略 uv.lock

# --------------------------------------------
# 5. 本地 AI 模型及权重
# --------------------------------------------
model/
models/
checkpoints/
weights/

*.safetensors
*.gguf
*.ggml
*.ckpt
*.pt
*.pth
*.onnx
*.tflite
*.mlmodel
*.mlpackage/
*.bin

# --------------------------------------------
# 6. 原始照片和图片
# --------------------------------------------
images/
photos/
pic/
uploads/
thumbnails/
previews/

# --------------------------------------------
# 7. 图片识别结果及向量文件
# --------------------------------------------
metadata/
vectors/
errors/
embeddings/
indexes/
index/
output/
results/
annotation_overrides.json

*.npy
*.npz
*.faiss

# --------------------------------------------
# 8. 本地数据库
# --------------------------------------------
*.db
*.sqlite
*.sqlite3
*.duckdb

# --------------------------------------------
# 9. 日志和临时文件
# --------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.pid
tmp/
temp/

# --------------------------------------------
# 10. 环境变量及敏感信息
# --------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# --------------------------------------------
# 11. macOS 系统文件
# --------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
.fseventsd

# --------------------------------------------
# 12. IDE 和编辑器
# --------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace

# --------------------------------------------
# 13. Jupyter Notebook 缓存
# --------------------------------------------
.ipynb_checkpoints/

# --------------------------------------------
# 14. 本地测试与运行缓存
# --------------------------------------------
.cache/
.cache/huggingface/
.cache/modelscope/
.cache/torch/
.cache/mlx/

# --------------------------------------------
# 15. 保留目录结构
# --------------------------------------------
!images/.gitkeep
!metadata/.gitkeep
!vectors/.gitkeep
!output/.gitkeep

